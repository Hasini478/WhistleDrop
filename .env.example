# WhistleDrop Environment Configuration Example
# Copy this file to .env and configure your local settings.

# Moderator HTTP Basic Auth Credentials
MODERATOR_USERNAME=moderator
MODERATOR_PASSWORD=change-this-password

# Secret key used for cryptographic hashing of case codes (HMAC-SHA256)
SECRET_KEY=replace-with-a-long-random-secret

# Database URL (SQLite default for local development)
DATABASE_URL=sqlite:///./whistledrop.db
